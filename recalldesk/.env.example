# ============================================================
# RecallDesk Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider (xKiro gateway — OpenAI-compatible) ─────────
LLM_PROVIDER=openai
# Recommended free models:
#   qwen/qwen3.7-flash:free   (fastest)
#   qwen/qwen3.7-max:free     (higher quality)
#   qwen/qwen3.8-omni-flash:free
LLM_MODEL=qwen/qwen3.7-flash:free
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_API_KEY=your-xkiro-api-key-here
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ── Hindsight Memory ─────────────────────────────────────────
# Set to false — uses in-process fallback memory store by default
HINDSIGHT_EMBEDDED=false
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=qwen/qwen3.7-flash:free
# Uses LLM_API_KEY if blank
HINDSIGHT_LLM_API_KEY=

# Optional: connect to a running Hindsight server for full persistent memory
# HINDSIGHT_BASE_URL=http://localhost:8888
# HINDSIGHT_API_KEY=your-hindsight-cloud-key

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./recalldesk.db

# ── App ──────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
