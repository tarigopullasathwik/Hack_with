# ============================================================
# RecallDesk Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Provider name (openai, anthropic, groq, etc.)
LLM_PROVIDER=openai

# Model to use
LLM_MODEL=gpt-4o-mini

# Your API key for the LLM provider
LLM_API_KEY=sk-your-openai-key-here

# Optional: custom base URL (for proxies or alternative providers)
# LLM_BASE_URL=https://api.openai.com/v1

# ── Hindsight Memory ─────────────────────────────────────────
# Use embedded mode (no Docker/server required) — recommended for local dev
HINDSIGHT_EMBEDDED=true

# LLM that Hindsight uses internally for memory extraction
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=gpt-4o-mini

# Uses LLM_API_KEY if this is blank
HINDSIGHT_LLM_API_KEY=

# Embedding + reranker backends for the embedded Hindsight server.
#   local (default) = sentence-transformers + PyTorch, downloaded from HuggingFace
#   onnx            = onnxruntime + transformers, no PyTorch
#   openai / gemini / cohere / tei = external service (needs its own key)
# If the local ML stack cannot load on your machine (e.g. blocked DLLs on
# Windows, or no PyTorch), switch to a remote embedder and the dependency-free
# "rrf" reranker:
# HINDSIGHT_EMBEDDINGS_PROVIDER=openai
# HINDSIGHT_RERANKER_PROVIDER=rrf
HINDSIGHT_EMBEDDINGS_PROVIDER=local
HINDSIGHT_RERANKER_PROVIDER=rrf

# Seconds to wait for the embedded Hindsight server to start before falling back
# HINDSIGHT_START_TIMEOUT=45

# Only needed for Hindsight Cloud (non-embedded)
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=your-hindsight-cloud-key

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./recalldesk.db

# ── App ──────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
